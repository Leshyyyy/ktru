# Скопируйте в ml/.env (файл в .gitignore) и заполните. Без ключа всё работает; ключ нужен только для RERANKER=llm (Jev).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
JEV_MODEL=typesafe/jev-1.14
# none | cross_encoder | llm (llm = выбор модели LLM_MODEL среди кандидатов, без LLM_MODEL — Jev). На замерах не помог.
# LLM_MODEL=anthropic/claude-haiku-5.5
RERANKER=none
EXTRACTOR=rules
# Модель категорий ОКПД2 по карточкам СТЕ (по умолчанию ml/models/category.joblib). «-» — выключить.
# CATEGORY_MODEL_PATH=ml/models/category.joblib
# Эмбеддинги наименований (нужны torch и sentence-transformers). С DATABASE_URL (или POSTGRES_*/APP_DB_* из compose)
# векторы хранятся в catalog_items.embedding (pgvector, дополнены нулями до 1024). По умолчанию выключены.
# EMBEDDER_MODEL=intfloat/multilingual-e5-small
