# Скопируйте в ml/.env (файл в .gitignore) и заполните. Без ключа всё работает; ключ нужен только для RERANKER=llm (Jev).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
JEV_MODEL=typesafe/jev-1.14
# none | cross_encoder | llm (llm = Jev через OpenRouter)
RERANKER=none
EXTRACTOR=rules
# Модель категорий ОКПД2 по карточкам СТЕ (python -m ml.category ...). Нет файла — поиск по всему каталогу.
# CATEGORY_MODEL_PATH=ml/artifacts/category.joblib
