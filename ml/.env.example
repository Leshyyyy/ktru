# Скопируйте в ml/.env (файл в .gitignore) и заполните. Без ключа всё работает; ключ нужен только для RERANKER=llm (Jev).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
JEV_MODEL=typesafe/jev-1.14
# none | cross_encoder | llm (llm = Jev через OpenRouter)
RERANKER=none
EXTRACTOR=rules
# Модель категорий ОКПД2 по карточкам СТЕ (по умолчанию ml/models/category.joblib). «-» — выключить.
# CATEGORY_MODEL_PATH=ml/models/category.joblib
