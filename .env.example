# Настройки AI-классификатора КТРУ.
#
# Для `docker compose up --build` ничего задавать не нужно: значения по умолчанию уже в docker-compose.yml.
# Чтобы поменять, скопируйте файл в .env (он в .gitignore) и правьте там.
#
# Пароли ниже — только для локального запуска: база и Redis не видны снаружи Docker, а API слушает
# 127.0.0.1. Для общего сервера задайте свои пароли до первого запуска.

# --- Режим ---------------------------------------------------------------------------------------------
# real — конвейер из ml/ и полный каталог КТРУ: migrate скачивает его при первом запуске (не скачался —
#        откат на заглушку, причина в /api/v1/health);
# stub — заглушка ML (коды 99.99.*, каталог contracts/fixtures/fake_catalog.jsonl), без скачивания каталога.
PIPELINE=real
# DEBUG | INFO | WARNING | ERROR. Логи в JSON с request_id и job_id.
LOG_LEVEL=INFO

# --- PostgreSQL ------------------------------------------------------------------------------------------
POSTGRES_DB=ktru
# Владелец схемы: им работает только контейнер migrate (миграции, роль приложения, стартовый каталог).
POSTGRES_USER=ktru
POSTGRES_PASSWORD=ktru_owner_local_only
# Роль приложения (api и воркеры): читать и писать данные может, менять схему — нет. Её создаёт migrate.
APP_DB_USER=ktru_app
APP_DB_PASSWORD=ktru_app_local_only
# Нужны только при запуске вне Docker: в compose адреса сервисов заданы в docker-compose.yml.
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# DB_CONNECT_TIMEOUT_S=3
# Запрос API дольше этого времени прерывается (мс).
# API_STATEMENT_TIMEOUT_MS=30000

# --- Redis (брокер Celery) -----------------------------------------------------------------------------
REDIS_PASSWORD=ktru_redis_local_only
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0

# --- API --------------------------------------------------------------------------------------------------
# Адрес, на котором API доступен с хоста. 0.0.0.0 — открыть API для других машин сети.
API_BIND=127.0.0.1
API_PORT=8000
# Веб-интерфейс (сервис frontend). 0.0.0.0 — открыть его для других машин сети.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Через запятую. Нужен, только если фронт открыт с другого адреса, чем API (через nginx адрес один).
CORS_ORIGINS=http://localhost:5173
# Swagger на /api/v1/docs. Источник правды для API — contracts/openapi.yaml.
API_DOCS=false
# Куда сохраняются загруженные файлы (том uploads).
# UPLOAD_DIR=/data/uploads
# Какие файлы принимает POST /files, через запятую. Читаться умеют xlsx, xls, csv, pdf.
UPLOAD_EXTENSIONS=xlsx,csv,pdf
# Через сколько часов удалять загруженный файл, по которому так и не создали задачу (worker-io, раз в час).
UPLOAD_TTL_HOURS=24
# Лимит файла POST /catalog/import (JSONL), МБ. Через nginx (порт интерфейса) пройдёт не больше 60 МБ —
# большой каталог загружайте напрямую в API (порт 8000).
CATALOG_IMPORT_MAX_MB=300

# --- Лимиты и пороги (фронт получает их в GET /config) ---------------------------------------------------
MAX_FILE_MB=50
MAX_ROWS=5000
MAX_ITEMS_PER_JOB=1000
CLASSIFY_MAX_ITEMS=20
# Сколько POST /classify ждёт ответа worker-ml (он может досчитывать пачку большой задачи), секунд.
CLASSIFY_TIMEOUT_S=30
GREEN_THRESHOLD=0.85
YELLOW_THRESHOLD=0.50

# --- ML (worker-ml) ---------------------------------------------------------------------------------------
# Процессов в worker-ml. Каждый держит свою копию моделей в памяти: увеличивать после замера.
ML_WORKER_CONCURRENCY=1
# Каталог КТРУ в формате CatalogRow для PIPELINE=real: его загружает migrate и читает worker-ml.
# Пусто — /data/catalog/catalog.jsonl на томе catalog (скачивает migrate). Свой файл смонтируйте в оба
# контейнера (пример — в backend/CLAUDE.md).
KTRU_CATALOG_PATH=
# Разметка для оценки качества (*.jsonl, поля eval_samples) — её загружает migrate. В образе — contracts/fixtures/eval.
# EVAL_SAMPLES_DIR=/srv/contracts/fixtures/eval
# Переменные ML — ml/config.py. По умолчанию то, что работает без ключей и без torch: правила, без реранкера.
EXTRACTOR=rules
RERANKER=none
DEVICE=cpu
# Модель эмбеддингов. Пусто — e5-small из образа worker-ml; «-» — без эмбеддингов (поиск на TF-IDF, меньше памяти).
EMBEDDER_MODEL=
# OpenAI-совместимый LLM. Пусто — LLM выключен, режим degraded. Ключ получает только worker-ml.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Заглушка: задержка на позицию и принудительный режим degraded (1 — включить).
STUB_DELAY_MS=20
STUB_DEGRADED=0
# Готовность worker-ml: как часто он сообщает о себе, сколько живёт отметка и сколько ждать загрузки моделей (с).
# ML_HEARTBEAT_INTERVAL_S=10
# ML_READY_TTL_S=30
# ML_WORKER_INIT_TIMEOUT_S=600
